// Esquema de datos — Neon Led Spain
// Prisma 7 (generador ESM). El cliente se genera en lib/generated/prisma.
// La URL de conexión se lee de DATABASE_URL vía prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------ Enums

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  NEW // pedido recibido, pendiente de producción
  IN_PRODUCTION // en fabricación
  SHIPPED // enviado
  DELIVERED // entregado
  CANCELLED // cancelado
}

enum RequestStatus {
  NEW // solicitud recibida
  QUOTED // presupuestada
  ACCEPTED // aceptada por el cliente
  REJECTED // descartada
}

enum OrderItemKind {
  PRODUCT // producto de catálogo
  CUSTOM // neón personalizado (configurador)
}

enum CustomerType {
  PARTICULAR
  COMPANY
}

// --------------------------------------------------------------- Usuarios

/// Perfil ligado a Supabase Auth. `id` = uuid de auth.users.
model Profile {
  id        String   @id
  email     String   @unique
  name      String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  orders    Order[]
}

// --------------------------------------------------------------- Catálogo

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  label    String
  position Int       @default(0)
  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String      @default("")
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  /// Precio base (tamaño Mediano) en céntimos.
  priceCents  Int
  /// Color neón principal (hex).
  color       String      @default("#ec1e8c")
  /// Emoji para diseños de icono/dibujo (opcional).
  symbol      String?
  /// URLs de imágenes (Supabase Storage). Vacío = se renderiza en neón.
  images      String[]    @default([])
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]

  @@index([categoryId])
}

// ----------------------------------------------- Reglas de precio (admin)

/// Reglas del configurador editables desde el admin (tamaños, soportes, uso…).
/// Sustituirán a las constantes de lib/neon-options.ts + lib/pricing.ts.
model PricingRule {
  id          String  @id @default(cuid())
  /// Grupo: SIZE | SUPPORT | USAGE | CHAR
  group       String
  /// Código dentro del grupo (p. ej. "m", "exterior", "contorno").
  code        String
  label       String
  /// Importe base o extra, en céntimos.
  amountCents Int     @default(0)
  /// Multiplicador (p. ej. uso exterior ×1.25). Nulo si no aplica.
  multiplier  Float?
  /// Datos adicionales (dimensiones, caracteres incluidos, etc.).
  meta        Json?

  @@unique([group, code])
}

// ------------------------------------------------- Ajustes de la tienda

/// Ajustes editables desde el admin que no encajan en el resto de modelos
/// (clave → JSON). Hoy: "trustpilot". El código siempre lleva un valor por
/// defecto, así que una clave ausente no rompe nada.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- Pedidos

model Order {
  id        String      @id @default(cuid())
  /// Referencia legible para el cliente: NLS-2026-0001.
  number    String      @unique
  profileId String?
  profile   Profile?    @relation(fields: [profileId], references: [id])
  status    OrderStatus @default(NEW)

  // --- Importes (céntimos) ---
  subtotalCents Int
  shippingCents Int @default(0)
  totalCents    Int

  // --- Cliente ---
  customerType  CustomerType @default(PARTICULAR)
  firstName     String
  lastName      String
  /// Razón social (solo empresas).
  companyName   String?
  /// NIF / NIE / CIF.
  taxId         String?
  customerEmail String
  customerPhone String

  // --- Envío / facturación ---
  /// { street, extra, postalCode, city, province, country }
  shippingAddress Json
  /// Null = misma que la de envío.
  billingAddress  Json?
  notes           String @default("")

  stripePaymentId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id         String        @id @default(cuid())
  orderId    String
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind       OrderItemKind
  name       String
  priceCents Int
  quantity   Int           @default(1)
  productId  String?
  product    Product?      @relation(fields: [productId], references: [id])
  /// Ficha de producción completa del neón personalizado (NeonConfig).
  customization Json?
  /// Desglose y estimaciones de fabricación (tubo, m², W) recalculados en servidor.
  breakdown     Json?

  @@index([orderId])
}

// ----------------------------------------------------- Seguridad del admin

/// Trabajador con acceso al panel. Cada uno tiene su contraseña (scrypt) y su
/// propio 2FA TOTP (obligatorio: se fuerza el alta en el primer login).
model AdminUser {
  id                String         @id @default(cuid())
  username          String         @unique
  passwordHash      String
  /// Solo el superadmin gestiona usuarios (crear, desactivar, resetear).
  isSuperadmin      Boolean        @default(false)
  active            Boolean        @default(true)
  /// Secreto TOTP activo (null = todavía sin configurar).
  totpSecret        String?
  /// Secreto pendiente durante el alta (aún sin confirmar con un código).
  totpPendingSecret String?
  /// Anti-replay: último time-step TOTP consumido.
  totpLastStep      Int            @default(0)
  createdAt         DateTime       @default(now())
  sessions          AdminSession[]
}

/// Sesión de administración: token aleatorio (se guarda su SHA-256, nunca el
/// token en claro). Revocable individualmente o en bloque.
model AdminSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  user        AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// true mientras el usuario aún no ha confirmado su 2FA (solo puede
  /// acceder a la pantalla de activación).
  pendingTotp Boolean   @default(false)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  lastUsedAt  DateTime  @default(now())
  ip          String?
  userAgent   String?

  @@index([expiresAt])
  @@index([userId])
}

/// Registro de intentos de login (rate-limiting y auditoría).
model AdminLoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([createdAt])
}

// --------------------------------------------- Solicitudes diseño a medida

/// Modo B: el cliente sube una imagen + tamaño deseado y pedimos presupuesto.
model CustomRequest {
  id            String        @id @default(cuid())
  imageUrl      String?
  desiredSize   String
  notes         String        @default("")
  customerName  String
  customerEmail String
  customerPhone String?
  status        RequestStatus @default(NEW)
  quoteCents    Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
}
