# ------------------------------------------------------------------
# Neon Led Spain — variables de entorno
# Copia este archivo a ".env" y rellena los valores reales.
# NUNCA subas ".env" al repositorio.
# ------------------------------------------------------------------

# --- Base de datos (Supabase Postgres) -----------------------------
# En Supabase: Project Settings → Database → Connection string.
# Usa la conexión DIRECTA (puerto 5432) para migraciones y para el
# servidor self-host (Node de larga vida en Ubuntu no necesita pooler).
# Formato: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:PASSWORD@db.TUPROYECTO.supabase.co:5432/postgres"

# --- Supabase API (auth + storage) ---------------------------------
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://TUPROYECTO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ...anon..."   # clave pública (safe)
SUPABASE_SERVICE_ROLE_KEY="eyJ...service_role..." # SECRETA — solo servidor

# --- Panel de administración ---------------------------------------
# Hash scrypt de la contraseña INICIAL del superadmin "admin" (no en claro).
# Solo se usa en el seed para crear ese usuario si no existe; el resto de
# usuarios se gestionan desde /admin/usuarios.
# Genéralo con: npx tsx scripts/hash-admin-password.mts "tu-contraseña"
ADMIN_PASSWORD_HASH="scrypt:..."

# --- (Más adelante) --------------------------------------------------
# STRIPE_SECRET_KEY=""            # pagos (última fase)
# STRIPE_WEBHOOK_SECRET=""
# RESEND_API_KEY=""              # emails de confirmación
